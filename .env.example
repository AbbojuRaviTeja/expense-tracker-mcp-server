# PostgreSQL connection (e.g. Neon). Required.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Google OAuth client. Required.
# Add {BASE_URL}/oauth/callback to "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Public URL of this server and the port it listens on.
BASE_URL="http://localhost:8000"
PORT=8000

# Defaults for new users (each user can change theirs with update-my-settings).
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# Tool calls allowed per user per minute.
RATE_LIMIT_PER_MINUTE=60

# debug | info | warn | error
LOG_LEVEL="info"

# Optional: send invite and reminder emails through https://resend.com
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Expense Tracker <noreply@yourdomain.com>"

# Only for running integration tests against a disposable database.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etm_test"
